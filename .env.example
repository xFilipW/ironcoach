# Skopiuj ten plik jako .env i wklej swój klucz API z Google AI Studio
# Klucz znajdziesz na: https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=twoj-klucz-gemini-tutaj
# Opcjonalnie – domyślnie używany jest gemini-2.5-flash-lite (darmowy, szybki, do tekstu)
# VITE_GEMINI_MODEL=gemini-2.5-flash-lite
